# -----------------------------------------------------------------------------
# K-Tech Client Portal — environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# -----------------------------------------------------------------------------

# Supabase — from Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — server-only, bypasses Row Level Security.
# Used by src/lib/supabase/admin.ts. Keep this out of any client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to build absolute URLs for email redirects (verification, password
# reset) and metadata. Set to your production domain when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — only needed if you regenerate types with `npm run db:types`.
SUPABASE_PROJECT_ID=your-project-ref

# ---- Phase 2 placeholders (not read by any code yet) ------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
